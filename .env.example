# Copy this file to .env and fill in real values. .env is git-ignored;
# these are placeholders only — do not put real values in this file.
#
# ESPN_S2 and SWID are session cookies from your own ESPN account (DevTools ->
# Application -> Cookies -> espn.com) and grant access to it — treat them like a
# password. Never commit them. In deployment (Step 4) they're injected by Cloud Run
# from Secret Manager, not read from this file.

GCP_PROJECT_ID=
LEAGUE_ID=
SEASON=
ESPN_S2=
SWID=
BIGQUERY_DATASET=fantasy
