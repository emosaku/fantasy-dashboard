# What `gcloud run deploy --source .` must NOT upload to Cloud Build. Only the
# dashboard's image is built from here, and it needs just Dockerfile,
# requirements.txt, app/, .streamlit/config.toml and three files of ingest/.

# Secrets -- never leave this machine
.env
.streamlit/secrets.toml
manager-logins.csv

# Everything else the image doesn't use
.git/
.gitignore
.github/
.venv/
venv/
**/__pycache__/
.pytest_cache/
.ruff_cache/
.DS_Store
ingest/*
!ingest/__init__.py
!ingest/catalog.py
!ingest/espn_client.py
sql/
tests/
notebooks/
docs/
scripts/
*.md
